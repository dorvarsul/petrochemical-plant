# PetroTwin Phase 2.5 — host/IP map for the 4-PC distributed deployment.
#
# Copy this file to `hosts.env` (gitignored — it holds YOUR lab's real IPs)
# and fill in the four addresses once:
#
#   cp deploy/hosts.env.example deploy/hosts.env
#   $EDITOR deploy/hosts.env
#
# Then on EACH PC, before launching its layer:
#   source deploy/hosts.env
#
# Every PC sources the SAME file (so everyone agrees on the topology); each
# layer's code only reads the variables it actually needs (see
# common/deploy_config.py — every variable here defaults to 127.0.0.1 if
# unset, i.e. Phase 0-2's single-host layout, so nothing breaks if you skip
# this file entirely on a single machine).
#
# Ports are unchanged from the single-host layout (ARCHITECTURE.md register
# map) — only the HOST changes. Only override a _PORT if you deliberately
# moved a service off its default port.
#
# Phase 2.5 topology: each layer lives in its OWN VLAN/subnet behind one
# layer-3 (routed) switch (so the example IPs below are in different /24s on
# purpose). The L3 switch must route between those subnets with Modbus (502)
# + the OpenPLC web ports allowed from PC1/PC4 to PC2/PC3 — see DEPLOY.md
# step 0. The IPs just need to be mutually ROUTABLE, not in one subnet.

# --- PC2: Control PLC / BPCS  (control VLAN) --------------------------------
export PETROTWIN_BPCS_HOST=10.0.2.12
# export PETROTWIN_BPCS_MODBUS_PORT=5020   # Modbus TCP slave (bridge + HMI)
# export PETROTWIN_BPCS_WEB_PORT=8081      # OpenPLC web UI (program load/restart)

# --- PC3: Safety PLC / SIS  (safety VLAN — on its own network) --------------
export PETROTWIN_SIS_HOST=10.0.3.13
# export PETROTWIN_SIS_MODBUS_PORT=5021
# export PETROTWIN_SIS_WEB_PORT=8082

# --- PC1: Physics + 3D (and the bundled /hmi tab, for convenience) --------
# PC1 is both the Modbus master (bridge) AND the web server for the 3D tab.
# Bind 0.0.0.0 so the 3D view can be opened from a browser on any PC the switch
# routes to PC1 (still unspoofable: the 3D data never leaves PC1's process via
# Modbus — see ARCHITECTURE.md "the two data taps"). Leave at 127.0.0.1 to view
# only from PC1 itself.
export PETROTWIN_PLANT_BIND_HOST=0.0.0.0
# export PETROTWIN_PLANT_PORT=8092

# --- PC4: standalone HMI (Modbus-only; polls PC2+PC3 directly) ------------
export PETROTWIN_HMI_BIND_HOST=0.0.0.0
# export PETROTWIN_HMI_PORT=8093

# --- Attacker (any host the switch routes to the PLC subnets, incl. a 5th box) ---
# attack/attack.py reads PETROTWIN_BPCS_HOST / PETROTWIN_SIS_HOST too (via
# common/registers.py), so sourcing this same file on the attacker host is
# enough — no separate attacker-specific variable.
